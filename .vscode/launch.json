{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Forge (Launch.exe)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Launch.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "externalTerminal",
            "preLaunchTask": "Build Forge"
        },
        {
            "name": "Debug Server (forge_server)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/forge_server.exe",
            "args": ["--port", "8080"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal"
        },
        {
            "name": "Run Tests (forge_tests)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/forge_tests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal"
        }
    ]
}
